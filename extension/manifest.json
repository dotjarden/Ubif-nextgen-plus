{
  "manifest_version": 3,
  "name": "UBIF NextGen Plus",
  "description": "Update Today work order board, Portal notes and scheduling, scanning, universal search, custom columns, dark mode, note templates, keyboard shortcuts, and Samsung exception forms.",
  "version": "0.9.1",
  "permissions": [
    "storage",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.ubreakifix.net/*"
      ],
      "js": [
        "page.js",
        "messages-page.js",
        "arrivals-page.js",
        "buyback-page.js",
        "label-page.js",
        "checkin.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.ubreakifix.net/*"
      ],
      "js": [
        "settings.js",
        "vendor/darkreader.js",
        "theme.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://portal.ubreakifix.net/*"
      ],
      "js": [
        "sidebar.js",
        "employee.js",
        "home.js",
        "arrivals.js",
        "scanner.js",
        "model.js",
        "content.js",
        "search-model.js",
        "search.js",
        "board-model.js",
        "board.js",
        "message-model.js",
        "message-ui.js",
        "messages.js",
        "support.js",
        "buyback.js",
        "label.js",
        "note-templates.js",
        "hotkey-model.js",
        "note-picker.js",
        "hotkeys.js",
        "samsung-model.js",
        "samsung.js",
        "imei-copy.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://forms-prod.sprinklr.com/*"
      ],
      "js": [
        "samsung-model.js",
        "sprinklr.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UBIF NextGen Plus settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
