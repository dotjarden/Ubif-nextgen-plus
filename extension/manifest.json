{
  "manifest_version": 3,
  "name": "UBIF NextGen Plus",
  "description": "Scan work orders and purchase-order receiving labels without focusing a field, search the portal, and customize columns.",
  "version": "0.4.1",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.ubreakifix.net/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.ubreakifix.net/*"
      ],
      "js": [
        "scanner.js",
        "model.js",
        "content.js",
        "search-model.js",
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
